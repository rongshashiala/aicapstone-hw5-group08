#    Annotations
#################################################################

<https://hcis.io/ontology/aicapstone/2026/CollectableObject> rdfs:comment "A task role for an object that should be collected into another object or location."@en ;
                                                             rdfs:label "collectable object"@en .


<https://hcis.io/ontology/aicapstone/2026/ContainerTarget> rdfs:comment "A task role for an object that receives or contains other objects."@en ;
                                                           rdfs:label "container target"@en .


<https://hcis.io/ontology/aicapstone/2026/ReferenceObject> rdfs:comment "A task role for an object used as a spatial or semantic reference for arranging other objects."@en ;
                                                           rdfs:label "reference object"@en .


<https://hcis.io/ontology/aicapstone/2026/RobotAgent> rdfs:comment "A robot or robot-controlled agent that can perceive objects, reason over the ontology, and act in the task environment."@en ;
                                                      rdfs:label "robot agent"@en .


<https://hcis.io/ontology/aicapstone/2026/TargetObject> rdfs:comment "A task role for an object that is directly acted upon or manipulated."@en ;
                                                        rdfs:label "target object"@en .


